# Скопируйте файл в .env и при необходимости измените значения.
# .env добавлен в .gitignore и не должен попадать в репозиторий.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aviation
DB_USER=aviation
DB_PASSWORD=aviation

# --- HTTP ---
# По правилам Nominatim User-Agent должен идентифицировать приложение.
APP_USER_AGENT=https://github.com/Basrik-alt
# Необязательно: e-mail для больших серий запросов к Nominatim.
NOMINATIM_EMAIL=
NOMINATIM_REQUEST_DELAY=1.1

# --- OpenSky Network (необязательно) ---
# Без учётных данных API работает в анонимном режиме с уменьшенными лимитами.
# Создать клиент OAuth2: https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_REQUEST_DELAY=3.0
OPENSKY_TIMEOUT=60
